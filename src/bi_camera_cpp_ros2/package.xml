<?xml version="1.0"?>
<package format="3">
  <name>bi_camera_cpp_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 C++ package for USB stereo cameras with MJPG capture, YAML-based device selection, and FPS benchmarking.</description>
  <maintainer email="good@example.com">good</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>opencv</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
