<?xml version="1.0"?>
<package format="3">
  <name>camera_bringup_ros2</name>
  <version>0.1.0</version>
  <description>Bringup package for stable mono and stereo USB camera launch configurations.</description>
  <maintainer email="good@example.com">good</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mono_camera_cpp_ros2</exec_depend>
  <exec_depend>bi_camera_cpp_ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
